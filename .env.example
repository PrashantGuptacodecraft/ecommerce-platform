# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. NEVER put real secrets in this file.

# ---------- Site ----------
SITE_URL=http://localhost:3000
NODE_ENV=development

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client bundle, logs, or Git.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Razorpay ----------
# Publishable key id — safe to expose to the client.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Server-only secrets. Never expose to the client bundle, logs, or Git.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Transactional email ----------
# Use either Resend OR SMTP, matching whichever provider lib/email implements.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=orders@yourstore.example

# SMTP fallback (only if not using Resend)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ---------- Security ----------
# Used to sign/verify any internal short-lived tokens (e.g. guest order tracking lookups).
APP_SECRET=
# Used to authenticate the reconciliation cron endpoint (GitHub Actions → /api/cron/).
CRON_SECRET=

# ---------- Rate limiting (if using an external store, e.g. Upstash Redis) ----------
RATE_LIMIT_KV_URL=
RATE_LIMIT_KV_TOKEN=
