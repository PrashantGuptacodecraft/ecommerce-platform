{
  "name": "studio-noir-ecommerce",
  "version": "0.1.0",
  "private": true,
  "description": "Premium mobile-first clothing e-commerce platform (India) — Phase 1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:smoke": "tsx tests/integration/0011-smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "tsx supabase/seed/seed.ts",
    "create-admin": "tsx supabase/seed/create-admin.ts",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/database.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@sentry/nextjs": "^10.65.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "clsx": "^2.1.1",
    "motion": "^12.42.2",
    "next": "^16.2.10",
    "razorpay": "^2.9.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.81.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overridesReason": "postcss>=8.5.10 forced into Next's transitive tree to close GHSA-qx2v-qp2m-jg93 (moderate, build-time CSS stringify XSS). Same-major backward-compatible pin; avoids the destructive `npm audit fix --force` downgrade of Next to 9.x. Remove once Next bumps its bundled postcss.",
  "overrides": {
    "postcss": "^8.5.10"
  }
}
